---
import EditLink from '@astrojs/starlight/components/EditLink.astro';
import LastUpdated from '@astrojs/starlight/components/LastUpdated.astro';
import Pagination from '@astrojs/starlight/components/Pagination.astro';

const { entry } = Astro.locals.starlightRoute;
const licenceBase = 'https://github.com/HosihikariFramework/hosihikariframework.github.io/blob/main';
const isSplash = Boolean(entry.data.hero);
---

<footer class:list={['site-footer', { 'site-footer--splash': isSplash }]}>
  {!isSplash && (
    <>
      <div class="site-footer__meta">
        <EditLink />
        <LastUpdated />
      </div>
      <Pagination />
    </>
  )}
  <p class="licence">
    Hosihikari Framework · 星光框架 · <a href={`${licenceBase}/LICENSE.md`}>Content CC BY-SA 4.0</a> · <a href={`${licenceBase}/LICENSE-CODE.md`}>Code MIT-0</a> ·{' '}
    <a class="licence-credit" href="https://starlight.astro.build/">
      <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
        <path fill-rule="evenodd" d="M15.19 6.75 12 0 8.81 6.75l-.19.38-1.68-1.88a1.2 1.2 0 1 0-1.69 1.69L7.13 8.8h-.38L0 12l6.75 3.19h.38l-1.88 1.87a1.2 1.2 0 1 0 1.69 1.69l1.68-1.88.2.38L12 24l3.19-6.75v-.38l1.69 1.88a1.2 1.2 0 1 0 1.68-1.69l-1.68-1.68.37-.2L24 12l-6.75-3.19-.38-.19 1.7-1.68a1.2 1.2 0 1 0-1.7-1.69L15.2 7.13v-.38ZM12 7.13l-.38.93a8.18 8.18 0 0 1-3.56 3.56l-.94.38.94.38a8.18 8.18 0 0 1 3.56 3.56l.38.94.38-.94a8.18 8.18 0 0 1 3.56-3.56l.94-.38-.94-.38a8.18 8.18 0 0 1-3.56-3.56L12 7.12Z" />
        <path d="M22.12 3.56a1.2 1.2 0 1 0-1.68-1.69l-.57.57a1.2 1.2 0 0 0 1.7 1.68l.55-.56Zm-18 .75c-.37.38-1.12.38-1.68 0l-.57-.56a1.2 1.2 0 0 1 1.7-1.69l.55.56c.57.38.57 1.13 0 1.7Zm0 15.38c-.37-.38-1.12-.38-1.68 0l-.57.56a1.2 1.2 0 1 0 1.7 1.69l.55-.57c.57-.37.57-1.12 0-1.68Zm18 .75a1.2 1.2 0 1 1-1.68 1.68l-.57-.56a1.2 1.2 0 0 1 1.7-1.69l.55.57Z" />
      </svg>
      {Astro.locals.t('builtWithStarlight.label')}
    </a>
  </p>
</footer>
